    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^1.83.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
